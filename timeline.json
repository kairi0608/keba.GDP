  "lines": [
    {"id": "j01", "role": "実況", "in": 3.4, "out": 6.9, "text": "さあスタートしました！各国、一斉に飛び出した！", "display": "さあスタートしました！\n各国、一斉に飛び出した！", "tts": {"speed": 1.25, "half_tone": 2}},
    {"id": "j02", "role": "実況", "in": 7.2, "out": 9.3, "text": "日本、まだ後方です！", "tts": {"speed": 1.2, "half_tone": 2}},
    {"id": "j03", "role": "実況", "in": 10.4, "out": 13.7, "text": "景気拡大！おっと、日本がここで加速！", "display": "景気拡大！\nおっと、日本がここで加速！", "tts": {"speed": 1.25, "half_tone": 2}},
    {"id": "j04", "role": "実況", "in": 14.4, "out": 16.6, "text": "さあカーブ！ペースが上がってきた！", "display": "さあカーブ！\nペースが上がってきた！", "tts": {"speed": 1.25, "half_tone": 2}},
    {"id": "j05", "role": "実況", "in": 17.15, "out": 19.75, "text": "高度経済成長、さらに加速！", "tts": {"speed": 1.2, "half_tone": 3}},
    {"id": "j06", "role": "実況", "in": 20.5, "out": 22.7, "text": "所得倍増へ、ぐんぐん伸びる！", "tts": {"speed": 1.25, "half_tone": 2}},
    {"id": "j07", "role": "実況", "in": 24.3, "out": 27.0, "text": "さらに伸びる！日本、順位を上げる！", "display": "さらに伸びる！\n日本、順位を上げる！", "tts": {"speed": 1.25, "half_tone": 2}},
    {"id": "j08", "role": "実況", "in": 28.1, "out": 30.6, "text": "日本、世界の先頭集団へ！", "tts": {"speed": 1.2, "half_tone": 2}},
    {"id": "j09", "role": "実況", "in": 31.0, "out": 33.0, "text": "このまま行けるか、日本！", "tts": {"speed": 1.2, "half_tone": 2}},
    {"id": "j10", "role": "実況", "in": 33.55, "out": 36.1, "text": "オイルショック！日本、ここで大きく減速！", "display": "オイルショック！\n日本、ここで大きく減速！", "tts": {"speed": 1.4, "half_tone": 2}},
    {"id": "j11", "role": "実況", "in": 36.75, "out": 39.0, "text": "政策が変わる！順位も変わる！", "pos": "top", "tts": {"speed": 1.2, "half_tone": 2}},
    {"id": "j12", "role": "実況", "in": 39.05, "out": 40.6, "text": "日本、ゴールへダッシュ！", "tts": {"speed": 1.25, "half_tone": 3}},
    {"id": "n01", "role": "ナレーション", "in": 41.2, "out": 44.1, "text": "もし、国の未来がレースだとしたら。", "display": "もし、国の未来が\nレースだとしたら。", "tts": {"speed": 1.0, "half_tone": -1}},
    {"id": "n02", "role": "ナレーション", "in": 44.45, "out": 47.6, "text": "その順位を決めているのは、何だろう？", "subtitle": false, "tts": {"speed": 1.0, "half_tone": -1}},
    {"id": "n03", "role": "ナレーション", "in": 50.1, "out": 52.5, "text": "政治を知る。経済を知る。", "style": "big", "tts": {"speed": 1.05, "half_tone": -1}},
    {"id": "n04", "role": "ナレーション", "in": 52.62, "out": 54.2, "text": "社会の仕組みを知る。", "style": "big", "tts": {"speed": 1.05, "half_tone": -1}},
    {"id": "n05", "role": "ナレーション", "in": 54.4, "out": 56.75, "text": "そして、未来を考える。", "style": "big", "tts": {"speed": 1.05, "half_tone": -1}},
    {"id": "n06", "role": "ナレーション", "in": 56.95, "out": 60.0, "text": "未来のレースを、誰がつくる？", "subtitle": false, "tts": {"speed": 0.95, "half_tone": -1}}
  ],
